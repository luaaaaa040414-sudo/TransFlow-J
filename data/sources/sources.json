  "project_context": {
    "note": "本清单是「各领域专业术语查询点」的通用分级体系，不限单一领域。制定时的首个实例是高校校史翻译（西南石油大学），项目的目标是把同一套分级策略泛化到各领域。",
    "initial_use_case": "高校校史翻译（西南石油大学），汉译英方向",
    "direction": "zh-en",
    "extensibility": "领域专用信源追加至 data/sources/domains/{domain}.json，与通用清单合并后生效；术语表按领域存于 data/glossary/{domain}.json",
    "summary_from_doc": [
      "一级源以「政府 + 本校 + 标准」三驾马车为主",
      "二级源以 CNKI 为绝对主力",
      "三级源集中在百科 + 地名网 + 有道",
      "未识别短链需人工逐一确认"
    ]
  }
